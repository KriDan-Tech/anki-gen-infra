# ─────────────────────────────────────────────────────────────────────────────
# dev-anki-gen — пример переменных окружения.
# Скопируйте в infra/.env и заполните секреты. Файл .env в git не идёт (.gitignore),
# держите его с правами 600. Здесь — только пустые/безопасные значения-заглушки.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (суперпользователь контейнера) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=postgres

# ── Пользователи баз сервисов (их создаёт postgres/init/01-databases.sh) ──
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
SOURCE_DB_USER=source
SOURCE_DB_PASSWORD=change-me-source-db
EXTRACTOR_DB_USER=extractor
EXTRACTOR_DB_PASSWORD=change-me-extractor-db
BUILDER_DB_USER=builder
BUILDER_DB_PASSWORD=change-me-builder-db
DECK_DB_USER=deck
DECK_DB_PASSWORD=change-me-deck-db

# ── RabbitMQ ──
RABBITMQ_DEFAULT_USER=anki
RABBITMQ_DEFAULT_PASS=change-me-rabbit

# ── ИИ-провайдер (любой OpenAI-совместимый API) ──
# Используют vocab-extractor (задача DETECT, этап 3) и card-builder (задача TRANSLATE, этап 2).
# В каркасе этапа 1 ИИ не вызывается. Модели выбираются по итогам проб этапа 0.
AI_BASE_URL=
AI_API_KEY=
AI_DETECT_MODEL=
AI_TRANSLATE_MODEL=
# Минимальный уровень рассуждений, который поддерживает выбранная модель; для моделей без
# рассуждений параметр не передаётся (план §1.5).
AI_REASONING_EFFORT=

# ── DeepL ──
# Резерв: будущая реализация TranslationProvider. В MVP не используется (ARCHITECTURE решение 36).
DEEPL_API_KEY=
