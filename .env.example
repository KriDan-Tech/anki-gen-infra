# ─────────────────────────────────────────────────────────────────────────────
# dev-anki-gen — пример переменных окружения.
# Скопируйте в infra/.env и заполните секреты. Файл .env в git не идёт (.gitignore),
# держите его с правами 600. Здесь — только пустые/безопасные значения-заглушки.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (суперпользователь контейнера) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=postgres

# ── Пользователи баз сервисов (их создаёт postgres/init/01-databases.sh) ──
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
SOURCE_DB_USER=source
SOURCE_DB_PASSWORD=change-me-source-db
EXTRACTOR_DB_USER=extractor
EXTRACTOR_DB_PASSWORD=change-me-extractor-db
BUILDER_DB_USER=builder
BUILDER_DB_PASSWORD=change-me-builder-db
DECK_DB_USER=deck
DECK_DB_PASSWORD=change-me-deck-db

# ── Keycloak (этап 6) ──
# Единственный адрес системы: IP сервера или домен, например 192.168.0.115. Все браузерные URL — https://<PUBLIC_HOST>/…
# (/, /api/, /auth/, /swagger-ui.html, /mailpit/). Адрес попадает в SAN самоподписанного сертификата; других адресов в .env нет.
PUBLIC_HOST=localhost
# Подсеть (одна, CIDR), из которой доступны /auth/admin/, /auth/realms/master/, Swagger UI и Mailpit UI.
# Проверяется по IP клиента на proxy; обязательна. Из других сетей — через SSH-туннель.
ADMIN_ALLOWED_CIDR=192.168.0.0/24
# Белый список всего стенда (один адрес или CIDR): с остальных адресов https://<PUBLIC_HOST>/ отвечает 403.
# Один IP — с /32, например 203.0.113.10/32. all — список выключен, стенд открыт всем. Обязательна.
# Админские пути выше проверяются только по ADMIN_ALLOWED_CIDR — при закрытом стенде задайте там тот же адрес.
ALLOWED_CIDR=all
# Первоначальный администратор Keycloak (KC_BOOTSTRAP_ADMIN_*), логин в админку: https://<PUBLIC_HOST>/auth/admin/
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Google OAuth client (владелец заводит в Google Cloud Console). Пока пустые: вход через Google не работает,
# остальные сценарии (регистрация по паролю, сброс пароля) работают.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── RabbitMQ ──
RABBITMQ_DEFAULT_USER=anki
RABBITMQ_DEFAULT_PASS=change-me-rabbit

# ── ИИ-провайдер (любой OpenAI-совместимый API) ──
# Используют vocab-extractor (задача DETECT, этап 3) и card-builder (задача TRANSLATE, этап 2).
# Пустой AI_DETECT_MODEL / AI_TRANSLATE_MODEL — ИИ не вызывается. Модели выбираются по итогам проб этапа 0.
# AI_BASE_URL: OpenAI — https://api.openai.com/v1 ; DeepSeek — https://api.deepseek.com (/v1 в адресе не нужен).
# Пусто — адрес SDK по умолчанию (в compose работает как https://api.openai.com/v1).
AI_BASE_URL=
AI_API_KEY=
AI_DETECT_MODEL=
AI_TRANSLATE_MODEL=
# Технические предохранители расходов (план §1.5): при превышении ИИ не вызывается, задача → FAILED.
# vocab-extractor: страниц к ИИ в одном извлечении; card-builder: слов к ИИ в одной сборке.
AI_MAX_PAGES_PER_EXTRACTION=200
AI_MAX_WORDS_PER_BUILD=2000
# Минимальный уровень рассуждений, который поддерживает выбранная модель; для моделей без
# рассуждений параметр не передаётся (план §1.5).
# DeepSeek: пусто = рассуждения включены (effort high по умолчанию); без рассуждений — none.
AI_REASONING_EFFORT=
# Формат ответа: json_schema (structured output, OpenAI) или json_object (DeepSeek: схема в system-сообщении,
# ответ проверяется по JSON Schema на нашей стороне).
AI_RESPONSE_FORMAT=json_schema
# Лимит max_tokens; пусто — не передаётся. Для DeepSeek без рассуждений рекомендуется 16384.
AI_MAX_TOKENS=
# Пример набора для DeepSeek (раскомментировать вместо значений выше):
# AI_BASE_URL=https://api.deepseek.com
# AI_DETECT_MODEL=deepseek-flash
# AI_TRANSLATE_MODEL=deepseek-flash
# AI_RESPONSE_FORMAT=json_object
# AI_REASONING_EFFORT=none
# AI_MAX_TOKENS=16384

# ── DeepL ──
# Резерв: будущая реализация TranslationProvider. В MVP не используется (ARCHITECTURE решение 36).
DEEPL_API_KEY=
