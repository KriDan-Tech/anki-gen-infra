services:
  stalwart:
    image: stalwartlabs/stalwart:{{ stalwart_image_version }}
    container_name: stalwart
    init: true
    restart: unless-stopped
    ports:
      - "25:25"
      - "465:465"
      - "993:993"
      - "995:995"
      - "4190:4190"
      - "8080:8080"
    volumes:
      - stalwart-etc:/etc/stalwart
      - stalwart-data:/var/lib/stalwart
      - /opt/lego/certificates:/certs:ro
    networks:
      default:
        aliases:
          - {{ stalwart_crt_domain }}

  roundcube:
    image: roundcube/roundcubemail:{{roundcube_version}}
    container_name: roundcube
    restart: unless-stopped

    depends_on:
      - stalwart

    ports:
      - "8085:80"

    environment:
      ROUNDCUBEMAIL_DB_TYPE: sqlite
      ROUNDCUBEMAIL_SKIN: elastic

      # IMAP Stalwart
      ROUNDCUBEMAIL_DEFAULT_HOST: "ssl://{{ stalwart_crt_domain }}"
      ROUNDCUBEMAIL_DEFAULT_PORT: 993

      # SMTP Stalwart
      ROUNDCUBEMAIL_SMTP_SERVER: "ssl://{{ stalwart_crt_domain }}"
      ROUNDCUBEMAIL_SMTP_PORT: 465

    volumes:
      - roundcube-db:/var/roundcube/db

volumes:
  stalwart-etc:
  stalwart-data:
  stalwart-logs:
  roundcube-db:
