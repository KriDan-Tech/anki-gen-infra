global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['prometheus:9090']

  - job_name: traefik
    scrape_interval: 15s
    metrics_path: /metrics
    static_configs:
      - targets:
          - '192.168.0.101:8082'


