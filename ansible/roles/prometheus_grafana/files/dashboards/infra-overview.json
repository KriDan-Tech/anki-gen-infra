        {
          "id": 10,
          "title": "Optional exporters — configuration and reachability",
          "type": "stat",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "description": "NOT CONFIGURED means no active target series; DOWN means configured but scrape failed; UP means scrape succeeded. A newly added target may take one scrape to appear.",
          "targets": [
            {
              "expr": "label_replace((2 + min(up{job=\"node-exporter\"})) or vector(0), \"job\", \"node-exporter\", \"\", \"\") or label_replace((2 + min(up{job=\"cadvisor\"})) or vector(0), \"job\", \"cadvisor\", \"\", \"\") or label_replace((2 + min(up{job=\"nginx\"})) or vector(0), \"job\", \"nginx\", \"\", \"\") or label_replace((2 + min(up{job=\"nginx-access-log\"})) or vector(0), \"job\", \"nginx-access-log\", \"\", \"\")",
              "legendFormat": "{{job}}",
              "refId": "A",
              "instant": true
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 2
                  },
                  {
                    "color": "green",
                    "value": 3
                  }
                ]
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "NOT CONFIGURED"
                    },
                    "2": {
                      "text": "DOWN"
                    },
                    "3": {
                      "text": "UP"
                    }
                  }
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
