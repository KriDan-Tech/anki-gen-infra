{
  "id": null,
  "uid": "infra-overview",
  "title": "Infrastructure overview",
  "tags": [
    "infra"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Application service health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Instant scrape state for configured Actuator targets, identified by service or address when unnamed. DOWN indicates a failed scrape.",
      "targets": [
        {
          "expr": "up{job=\"app-actuator\",service!=\"\"} or label_replace(up{job=\"app-actuator\",service=\"\"}, \"service\", \"$1\", \"instance\", \"(.+)\")",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "wideLayout": true
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "id": 12,
      "title": "API gateway requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Request throughput from the API gateway HTTP server request timer; Actuator endpoints are excluded.",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"app-actuator\",service=\"api-gateway\",uri!~\"/actuator(/.*)?\"}[$__rate_interval]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 13,
      "title": "API gateway 5xx ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of observed API gateway requests returning 5xx. No series is returned when there is no request traffic.",
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"app-actuator\",service=\"api-gateway\",uri!~\"/actuator(/.*)?\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{job=\"app-actuator\",service=\"api-gateway\",uri!~\"/actuator(/.*)?\"}[$__rate_interval])))) / (sum(rate(http_server_requests_seconds_count{job=\"app-actuator\",service=\"api-gateway\",uri!~\"/actuator(/.*)?\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 14,
      "title": "API gateway mean latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Mean observed API gateway request duration (timer seconds sum divided by request count); no series when there is no traffic.",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"app-actuator\",service=\"api-gateway\",uri!~\"/actuator(/.*)?\"}[$__rate_interval])) / (sum(rate(http_server_requests_seconds_count{job=\"app-actuator\",service=\"api-gateway\",uri!~\"/actuator(/.*)?\"}[$__rate_interval])) > 0)",
          "legendFormat": "mean",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      }
