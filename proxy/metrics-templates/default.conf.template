# NGINX metrics-only reverse proxy. Docker's embedded DNS is queried at request time
# so service replacement/IP changes do not leave cached startup addresses.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 9090;
    server_name _;
    location = /actuator/prometheus {
        allow ${METRICS_ALLOWED_CIDR};
        deny all;
        if ($request_method != GET) { return 405; }
        set $metrics_upstream api-gateway:9090;
        proxy_pass http://$metrics_upstream/actuator/prometheus;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
    }
    location / { return 404; }
}

