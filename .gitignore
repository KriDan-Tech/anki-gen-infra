# Реальные секреты — не в git. Шаблон: .env.example
.env
.vault_pass
*.retry

# Terraform
/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
/terraform/*.lock*

# Ansible
/ansible/inventory.ini
*.retry
.vault_pass
.vault_password

# SSH-ключи
/ansible/files/keys/*
!/ansible/files/keys/*.pub

# TLS-сертификат стенда: ключ и сертификат выпускает Ansible на ноде, в git не попадают
/certs/
